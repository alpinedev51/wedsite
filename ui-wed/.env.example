# For `npm run dev`: copy to .env.local (gitignored). Production images get
# these values as build args instead (root .env locally, GitHub repository
# variables in CI), with VITE_API_BASE_URL left unset.
#
# Cross-origin calls to the backend on :8000. Remove this line to use Vite's
# /api proxy instead (same origin, no CORS). Cross-origin needs DEBUG=true on
# the backend for the admin cookie (see the root README).
VITE_API_BASE_URL=http://localhost:8000

# Fallback text, shown until the live GET /api/v1/wedding answers.
VITE_COUPLE_NAMES=Mister & Missus
VITE_BRIDE_FNAME=Missus
VITE_GROOM_FNAME=Mister
# Dates: venue local time, same format as the root .env (see the note
# there) -- e.g. 2030-06-15, or 2030-05-01T23:59:59 for an end-of-day deadline.
VITE_WEDDING_DATE=YYYY-MM-DD
VITE_VENUE_NAME=
VITE_VENUE_CITY=
VITE_RSVP_DEADLINE=
