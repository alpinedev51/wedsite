# Copy to .env.local (or .env) and adjust if service-wed runs elsewhere.
# service-wed's CORS_ALLOW_ORIGINS already defaults to include Vite's
# default dev port (5173), and its cookie needs DEBUG=true locally to be
# sent over plain http -- see service-wed/README.md's "Integrating with a
# React + Vite + Node.js frontend" section.
VITE_API_BASE_URL=http://localhost:8000
