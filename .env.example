# Copy to .env (same directory as this file, next to docker-compose.yml)
# and fill in real values on the actual deployment host (e.g. the Pi) --
# docker-compose.yml reads these via ${VAR:-default} substitution for the
# service-wed and worker services. Never commit the real .env.

# ---------------------------------------------------------------------------
# Postgres credentials -- read by both the db service AND service-wed/
# worker's DATABASE_URL (the exact same variables, not separate copies), so
# there's no way for the connection string to drift out of sync with what
# Postgres actually has. POSTGRES_PASSWORD has no fallback default in
# docker-compose.yml -- `docker compose up` fails loudly if it's unset
# rather than silently reusing the old hardcoded "wedding_db_pw", which has
# appeared in plaintext throughout this project's history/testing and
# should be treated as burned. Pick a real, new password here.
# ---------------------------------------------------------------------------
POSTGRES_USER=wedding_db_user
POSTGRES_PASSWORD=
POSTGRES_DB=wedding_db

# ---------------------------------------------------------------------------
# Host-side ports -- only these need to move if something else on the box
# already owns them (this is exactly what happened with Pi-hole/Nextcloud).
# Container-internal ports are fixed and don't need to change.
# ---------------------------------------------------------------------------
HTTP_PORT=80
HTTPS_PORT=443
TRAEFIK_DASHBOARD_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379

# Leave RESEND_API_KEY unset to keep emails printing to the worker
# container's logs instead of actually sending (fine for testing the flow
# end-to-end without spamming real inboxes).
RESEND_API_KEY=
RESEND_FROM_ADDRESS=wedding@example.com

# Resend/Svix webhook signing secret -- leave unset for local dev (signature
# verification is skipped with a warning); required before /webhooks/resend
# is reachable from the internet.
RESEND_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Consumed by service_wed/scripts/container_bootstrap.py, which service-wed's
# container command runs once before uvicorn starts. Seeds the one admin
# account and the wedding config ONLY if they don't already exist -- never
# re-applied on later restarts, so it's safe to leave these set permanently.
# Leave ADMIN_EMAIL/ADMIN_PASSWORD/WEDDING_DATE/RSVP_DEADLINE unset to skip
# seeding entirely (e.g. if you'd rather do it by hand).
# ---------------------------------------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
WEDDING_DATE=
RSVP_DEADLINE=

# Optional -- falls back to these defaults if unset.
RSVP_OPENS_AT=
VENUE_NAME=
VENUE_ADDRESS=
REMINDER_CAP=3
REMINDER_INTERVAL_DAYS=14
