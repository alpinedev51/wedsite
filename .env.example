# Copy to .env (same directory as this file, next to docker-compose.yml)
# and fill in real values on the actual deployment host (e.g. the Pi) --
# docker-compose.yml reads these via ${VAR:-default} substitution for the
# service-wed and worker services. Never commit the real .env.
#
# Leave RESEND_API_KEY unset to keep emails printing to the worker
# container's logs instead of actually sending (fine for testing the flow
# end-to-end without spamming real inboxes).
RESEND_API_KEY=
RESEND_FROM_ADDRESS=wedding@example.com

# Resend/Svix webhook signing secret -- leave unset for local dev (signature
# verification is skipped with a warning); required before /webhooks/resend
# is reachable from the internet.
RESEND_WEBHOOK_SECRET=
