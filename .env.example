# One .env for the root docker-compose.yml -- on the server (runtime) and
# for local builds. On the server: copy to .env, fill in, chmod 600, and
# run deploy/deploy.sh (see deploy/README.md).
#
# Where each value is used:
#   runtime    -- read by the containers when they start (server .env)
#   build-time -- baked into the ui-wed image when it's built. On the
#                 server they do nothing: CI builds the image, taking them
#                 from GitHub repository variables of the same name.
#                 Locally they're read by `docker compose build`.

# --- runtime -----------------------------------------------------------
CLOUDFLARE_TUNNEL_TOKEN=

POSTGRES_USER=wedding_db_user
POSTGRES_PASSWORD=
POSTGRES_DB=wedding_db

# Host port for Traefik (bound to 127.0.0.1 in docker-compose.yml).
HTTP_PORT=80
# docker-compose-test.yml only (LAN/HTTPS testing) -- uncomment to change:
# HTTPS_PORT=443
# TRAEFIK_DASHBOARD_PORT=8080
# POSTGRES_PORT=5432
# REDIS_PORT=6379

# Where the app images come from. CI publishes to
# ghcr.io/alpinedev51/wedsite/{service-wed,ui-wed}; on the server it must be
# that registry path (deploy.sh checks it names a registry). For purely
# local builds any name works (e.g. wed-website).
IMAGE_REPO=ghcr.io/alpinedev51/wedsite
# Managed by deploy/deploy.sh (sha-<commit>) -- don't edit by hand on the
# server; use `deploy/deploy.sh <commit>` or `deploy/deploy.sh rollback`.
IMAGE_TAG=latest

RESEND_API_KEY=
RESEND_FROM_ADDRESS=wedding@example.com
# Optional. Sends per second to Resend; keep at or below your account's
# API rate limit (default 2).
RESEND_MAX_SENDS_PER_SECOND=2

RESEND_WEBHOOK_SECRET=

# Required, no fallback default (docker-compose.yml fails loudly if unset):
# wherever ui-wed is actually reachable, embedded as the RSVP link.
PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Consumed by service_wed/scripts/container_bootstrap.py, which service-wed's
# container command runs once before uvicorn starts. Seeds the one admin
# account and the wedding config ONLY if they don't already exist -- never
# re-applied on later restarts, so it's safe to leave these set permanently.
# Leave ADMIN_EMAIL/ADMIN_PASSWORD/WEDDING_DATE/RSVP_DEADLINE unset to skip
# seeding entirely (e.g. if you'd rather do it by hand).
# ---------------------------------------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Dates are Durango (venue) local time -- no UTC or daylight-saving math:
#   2027-09-04           a date alone = midnight at the start of that day
#   2027-06-28T23:59:59  a date and time = that wall-clock time in Durango
# For a deadline, give the time: a bare 2027-06-28 would close RSVPs at the
# START of June 28. service-wed and ui-wed both read these as Durango time
# (service_wed/config/venue.py, ui-wed/src/lib/date.ts). A value ending in Z
# or an offset (2027-09-04T06:00:00Z) is taken as that exact instant instead.
WEDDING_DATE=
RSVP_DEADLINE=

# Optional. Unset: RSVPs are open until RSVP_DEADLINE (no opening time),
# venue/names stay empty, REMINDER_CAP=2, REMINDER_INTERVAL_DAYS=7. The
# reminder values below are just an example.
RSVP_OPENS_AT=
VENUE_NAME=
VENUE_ADDRESS=
VENUE_CITY=
BRIDE_FNAME=
GROOM_FNAME=
REMINDER_CAP=3
REMINDER_INTERVAL_DAYS=14

# --- build-time (ui-wed) --------------------------------------------------
# ui-wed's Vite fallback text (shown until the live GET /wedding answers;
# see ui-wed/src/config/wedding.ts). Build args: COUPLE_NAMES, plus
# BRIDE_FNAME, GROOM_FNAME, WEDDING_DATE, VENUE_NAME, VENUE_CITY and
# RSVP_DEADLINE from above (those are ALSO runtime values for service-wed's
# first-boot seeding). In CI, set them as GitHub repository variables with
# these same names -- keep both in sync if you change them.
COUPLE_NAMES=
