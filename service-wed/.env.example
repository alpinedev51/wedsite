# Copy to .env and fill in as needed. Read by anything run from the host
# (Alembic migrations, one-off scripts) -- points at localhost because
# that's how the host sees Docker's published ports. The service-wed/worker
# containers get their own DATABASE_URL/REDIS_URL from docker-compose.yml
# instead (container-network hostnames db/redis, not localhost).

DATABASE_URL=postgresql+asyncpg://wedding_db_user:wedding_db_pw@localhost:5432/wedding_db
REDIS_URL=redis://localhost:6379

# Set true only for local dev: allows the admin session cookie to be sent
# over plain http (otherwise it's Secure-only) and echoes SQL statements.
DEBUG=false

# Leave unset to print emails to stdout instead of actually sending them.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=wedding@example.com

# Resend/Svix webhook signing secret. Leave unset for local dev (signature
# verification is skipped with a warning); required before /webhooks/resend
# is reachable from the internet.
RESEND_WEBHOOK_SECRET=

SESSION_COOKIE_NAME=admin_session

# Comma-separated list of frontend origins allowed to call this API with
# credentials (cookies). No wildcard -- every real origin must be listed.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173
