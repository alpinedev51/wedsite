# Consumed directly by docker-compose.yml's `db` service, and composed into
# DATABASE_URL for the service-wed/worker containers -- see that file.
# POSTGRES_PASSWORD has no fallback default on purpose (docker-compose.yml
# fails loudly if unset). Do not reuse wedding_db_pw.
POSTGRES_USER=wedding_db_user
POSTGRES_PASSWORD=
POSTGRES_DB=wedding_db

REDIS_URL=redis://redis:6379

# Set true only for local dev: allows the admin session cookie to be sent
# over plain http (otherwise it's Secure-only) and echoes SQL statements.
DEBUG=false

# Leave unset to print emails to stdout instead of actually sending them.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=wedding@example.com

# Resend/Svix webhook signing secret. Leave unset for local dev (signature
# verification is skipped with a warning); required before /webhooks/resend
# is reachable from the internet.
RESEND_WEBHOOK_SECRET=

SESSION_COOKIE_NAME=admin_session

# Header carrying the real visitor IP, used to key rate limits. The root
# docker-compose.yml sets CF-Connecting-IP (Cloudflare Tunnel). Leave unset
# when nothing trusted sets it -- a client could otherwise fake its IP.
CLIENT_IP_HEADER=

PUBLIC_SITE_URL=http://localhost:5173

CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------------------------------------------------------------------------
# scripts/bootstrap.sh only (not read by the app itself). Required: the one
# admin account this app has, and the wedding's date/RSVP deadline.
# ---------------------------------------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Dates are Durango (venue) local time -- no UTC or daylight-saving math:
#   2027-09-04           a date alone = midnight at the start of that day
#   2027-06-28T23:59:59  a date and time = that wall-clock time in Durango
# For a deadline, give the time: a bare 2027-06-28 would close RSVPs at the
# START of June 28. service-wed and ui-wed both read these as Durango time
# (service_wed/config/venue.py, ui-wed/src/lib/date.ts). A value ending in Z
# or an offset (2027-09-04T06:00:00Z) is taken as that exact instant instead.
WEDDING_DATE=
RSVP_DEADLINE=

# Optional -- bootstrap.sh falls back to these defaults if unset.
RSVP_OPENS_AT=
VENUE_NAME=
VENUE_ADDRESS=
VENUE_CITY=
BRIDE_FNAME=
GROOM_FNAME=
REMINDER_CAP=2
REMINDER_INTERVAL_DAYS=7
API_BASE_URL=http://localhost:8000
